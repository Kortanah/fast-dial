rules_version = '2';

// Firestore Security Rules for FlowDial Application & Gate System
//
// Security Policies:
// 1. users/{userId}:
//    - Read/Delete: Authenticated account owner only.
//    - Create: Owner only, preventing client setting protected server-controlled fields ('flags', 'access').
//    - Update: Owner only, strictly prohibiting client modification of 'flags' or 'access' fields.
// 2. Read-only Public Collections (read: if true/auth != null, write: if false):
//    - templates/{templateId}
//    - config/{configId}
//    - announcements/{announcementId}
//    - packages/{packageId}
// 3. Fully Server-Protected Collections (write/read: if false):
//    - processedTokens/{tokenId} (handled exclusively by Cloud Functions Admin SDK)

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      // Allow authenticated owner to read their document
      allow read: if request.auth != null && request.auth.uid == userId;

      // Allow owner to create document if protected fields ('flags', 'access') are NOT supplied by client
      allow create: if request.auth != null && request.auth.uid == userId 
        && !('flags' in request.resource.data)
        && !('access' in request.resource.data);

      // Allow owner to update document EXCEPT modifying 'flags' or 'access'
      allow update: if request.auth != null && request.auth.uid == userId 
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['flags', 'access']);

      // Allow owner to delete their document
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /templates/{templateId} {
      allow read: if true;
      allow write: if false;
    }

    match /config/{configId} {
      allow read: if true;
      allow write: if false;
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if false;
    }

    match /packages/{packageId} {
      allow read: if true;
      allow write: if false;
    }

    match /processedTokens/{tokenId} {
      allow read, write: if false;
    }
  }
}

